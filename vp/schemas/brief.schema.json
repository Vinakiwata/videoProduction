{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Brief video (00_brief/brief.yaml)",
  "type": "object",
  "required": [
    "title",
    "goal",
    "audience",
    "channel",
    "format",
    "target_duration_s",
    "tone",
    "cta",
    "brand"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3
    },
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "audience": {
      "type": "string",
      "minLength": 5
    },
    "channel": {
      "type": "string",
      "enum": [
        "youtube",
        "youtube_shorts",
        "tiktok",
        "facebook",
        "other"
      ]
    },
    "format": {
      "type": "object",
      "required": [
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 320
        },
        "height": {
          "type": "integer",
          "minimum": 320
        },
        "fps": {
          "type": "number",
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        }
      }
    },
    "target_duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "tone": {
      "type": "string",
      "minLength": 3
    },
    "cta": {
      "type": "string",
      "minLength": 3
    },
    "brand": {
      "type": "object",
      "required": [
        "colors",
        "fonts",
        "voice"
      ],
      "properties": {
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "fonts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "voice": {
          "type": "string",
          "minLength": 3
        },
        "logo": {
          "type": "string"
        },
        "scene_colors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "description": "Bảng màu tự nhiên cho cảnh minh hoạ (asset kind=scene); icon/chữ/nút vẫn dùng colors"
        },
        "mascot": {
          "type": "object",
          "required": [
            "name",
            "dir",
            "expressions"
          ],
          "additionalProperties": false,
          "description": "Linh vật của kênh: ảnh PNG nền trong suốt, mỗi biểu cảm một file",
          "properties": {
            "name": {
              "type": "string"
            },
            "dir": {
              "type": "string",
              "description": "Thư mục chứa PNG, tính từ gốc repo"
            },
            "expressions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "file",
                  "use"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-]+$"
                  },
                  "file": {
                    "type": "string"
                  },
                  "use": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "slogan": {
          "type": "string",
          "description": "Khẩu hiệu kênh"
        },
        "voice_pitch_semitones": {
          "type": "number",
          "minimum": -6,
          "maximum": 6,
          "description": "Nâng/hạ tông giọng sau khi tạo (nửa cung, giữ độ dài). Khỉ Khám Phá: +2,5 để giọng giống bạn ~15 tuổi"
        }
      }
    },
    "is_advertising": {
      "type": "boolean",
      "description": "Video có quảng cáo/tài trợ sản phẩm không"
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channel_ref": {
      "type": "string",
      "description": "Tên hồ sơ kênh trong channels/"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Giả định Claude tự đưa ra khi chủ dự án vắng mặt"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "description": "Nền tảng đăng (platforms/<id>.yaml). Một file video lên mọi nền tảng → lề an toàn chặt nhất từng cạnh."
    }
  }
}
