{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hồ sơ kênh (channels/<kênh>/channel.yaml)",
  "type": "object",
  "required": ["name", "channel", "format", "default_duration_s", "tone", "cta", "audience", "brand", "voice_profile"],
  "properties": {
    "name": {"type": "string", "minLength": 2},
    "channel": {"type": "string", "enum": ["youtube", "youtube_shorts", "tiktok", "facebook", "other"]},
    "format": {
      "type": "object", "required": ["width", "height", "fps"],
      "properties": {"width": {"type": "integer"}, "height": {"type": "integer"}, "fps": {"type": "number"}}
    },
    "default_duration_s": {"type": "number", "exclusiveMinimum": 0},
    "tone": {"type": "string"},
    "cta": {"type": "string"},
    "audience": {"type": "string"},
    "brand": {
      "type": "object", "required": ["colors", "fonts", "voice"],
      "properties": {
        "colors": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}},
        "fonts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "voice": {"type": "string"},
        "logo": {"type": "string"},
        "style": {"type": "string", "description": "Phong cách hình: nét, bóng, mức chi tiết"}
      }
    },
    "voice_profile": {
      "type": "object", "required": ["syllables_per_second"],
      "properties": {
        "syllables_per_second": {"type": "number", "exclusiveMinimum": 0},
        "calibrated": {"type": "boolean", "description": "Đã đo từ giọng thật chưa"}
      }
    },
    "notes": {"type": "string"}
  }
}
